# Server environment
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/vocallab

# Authentication
JWT_SECRET=your-super-secret-key-minimum-32-characters-change-this
JWT_EXPIRE=7d

# File Storage
MAX_FILE_SIZE=104857600
S3_BUCKET_NAME=vocallab-audio
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Redis Cache
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Email (SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=noreply@vocallab.ai

# Frontend URL
FRONTEND_URL=https://vocallab.ai

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/vocallab/app.log
