# VocalLab AI - Environment Configuration Template
# Copy this file to .env and update with your values

# ===== SERVER CONFIGURATION =====
PORT=5000
NODE_ENV=development

# ===== DATABASE CONFIGURATION =====
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/vocallab

# MongoDB Atlas (Cloud) - uncomment to use
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vocallab?retryWrites=true&w=majority

# ===== AUTHENTICATION =====
JWT_SECRET=your-super-secret-key-change-this-in-production-to-at-least-32-chars
JWT_EXPIRE=7d

# ===== FILE UPLOAD SETTINGS =====
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
ALLOWED_AUDIO_FORMATS=wav,mp3,flac,ogg

# ===== AI PROCESSING =====
AI_PROCESSING_TIMEOUT=300000
AI_ENABLE_ANALYSIS=true
AI_ENABLE_REMIX=true

# ===== CORS SETTINGS =====
FRONTEND_URL=http://localhost:3000

# ===== EMAIL CONFIGURATION (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@vocallab.ai

# ===== LOGGING =====
LOG_LEVEL=debug
LOG_FILE=./logs/vocallab.log

# ===== SECURITY =====
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
